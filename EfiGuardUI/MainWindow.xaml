<Window x:Class="EfiGuardUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EfiGuard UI" Height="860" Width="1280"
        MinHeight="640" MinWidth="960"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, Microsoft YaHei, Inter, sans-serif">

    <Border Background="#0a0a0a" CornerRadius="12" BorderBrush="#2a2a2c" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#111113" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="&#x25C8;" Foreground="#0066cc" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="EfiGuard UI" Foreground="#f5f5f7" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Nav -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavDashboard" Content="Dashboard / 仪表盘" Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click" Tag="Active"/>
                    <Button x:Name="NavOperations" Content="Operations / 操作" Style="{StaticResource NavButtonStyle}" Click="NavOperations_Click"/>
                    <Button x:Name="NavLogs" Content="Logs / 日志" Style="{StaticResource NavButtonStyle}" Click="NavLogs_Click"/>
                </StackPanel>

                <!-- Right: Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="&#x4E2D;/EN" Width="50" Height="28" Background="Transparent" Foreground="#86868b"
                            BorderThickness="0" FontSize="11" Click="LangToggle_Click" Cursor="Hand"/>
                    <Rectangle Width="1" Height="18" Fill="#2a2a2c" Margin="4,0"/>
                    <Button Content="&#x2212;" Width="32" Height="28" Background="Transparent" Foreground="#86868b"
                            BorderThickness="0" FontSize="16" Click="Minimize_Click" Cursor="Hand"/>
                    <Button Content="&#x25A1;" Width="32" Height="28" Background="Transparent" Foreground="#86868b"
                            BorderThickness="0" FontSize="12" Click="Maximize_Click" Cursor="Hand"/>
                    <Button Content="&#x00D7;" Width="32" Height="28" Background="Transparent" Foreground="#86868b"
                            BorderThickness="0" FontSize="16" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Admin Banner -->
            <Border x:Name="AdminBanner" Grid.Row="1" Background="#1a0a0a" BorderBrush="#ff453a" BorderThickness="0,0,0,1"
                    Padding="16,8" Visibility="Collapsed">
                <TextBlock Text="&#x26A0; 未以管理员身份运行 / Not running as Administrator" Foreground="#ff453a"
                           FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="2" Background="#000000" CornerRadius="0,0,12,12">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
            </Border>
        </Grid>
    </Border>
</Window>
