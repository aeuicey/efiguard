<Page x:Class="EfiGuardUI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24">
            <!-- Hero -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <Border Background="#0d1f33" BorderBrush="#1a3a5c" BorderThickness="1" CornerRadius="16"
                        Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#30d158" Margin="0,0,8,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.5" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="LiveText" Text="实时监控中 / Live Monitoring" Foreground="#0066cc" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TitleText" Text="系统安全中心" FontSize="40" FontWeight="Bold" Foreground="#f5f5f7"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="SubtitleText" Text="可视化管理系统虚拟化与安全功能状态" FontSize="16" Foreground="#6e6e73"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Status Grid -->
            <WrapPanel x:Name="StatusCardsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Cards will be created dynamically -->
            </WrapPanel>

            <!-- Info Footer -->
            <Border Background="#111113" BorderBrush="#2a2a2c" BorderThickness="1" CornerRadius="12"
                    Padding="20,14" Margin="0,32,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="OsInfoText" Text="--" Foreground="#86868b" FontSize="12" FontFamily="Consolas"/>
                    <Rectangle Width="1" Height="16" Fill="#2a2a2c" Margin="16,0"/>
                    <TextBlock x:Name="UpdatedText" Text="--" Foreground="#86868b" FontSize="12" FontFamily="Consolas"/>
                    <Rectangle Width="1" Height="16" Fill="#2a2a2c" Margin="16,0"/>
                    <TextBlock Text="Interval: 5s" Foreground="#86868b" FontSize="12" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
