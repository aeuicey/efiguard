<Page x:Class="EfiGuardUI.Views.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Border Background="#0d1f33" BorderBrush="#1a3a5c" BorderThickness="1" CornerRadius="16"
                    Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#30d158" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LogsBadge" Text="系统日志 / System Logs" Foreground="#0066cc" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="LogsTitle" Text="操作日志" FontSize="40" FontWeight="Bold" Foreground="#f5f5f7" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LogsSubtitle" Text="命令执行输出与状态记录" FontSize="16" Foreground="#6e6e73"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Logs Header -->
        <Border Grid.Row="1" Background="#111113" BorderBrush="#2a2a2c" BorderThickness="1,1,1,0"
                CornerRadius="12,12,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="#30d158" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock x:Name="LiveLabel" Grid.Column="1" Text="实时输出 / Live Output" Foreground="#86868b" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
                <Button Grid.Column="2" Content="清空 / Clear" Background="Transparent" BorderBrush="#2a2a2c"
                        BorderThickness="1" Foreground="#6e6e73" FontSize="11" Padding="10,4"
                        Click="Clear_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Logs Content -->
        <Border Grid.Row="2" Background="#0a0a0a" BorderBrush="#2a2a2c" BorderThickness="1"
                CornerRadius="0,0,12,12">
            <ScrollViewer x:Name="LogsScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogsTextBox" Background="Transparent" Foreground="#86868b" FontFamily="Consolas"
                         FontSize="12" Padding="16" BorderThickness="0" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Text="等待操作执行... / Waiting for operations..."/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
